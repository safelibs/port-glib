# Cargo build output
/target/

# Build directories (Rust harnesses, meson, dpkg-buildpackage workdirs)
/build-bootstrap/
/build-*/
/package-baseline-bootstrap/
/package-baseline-verify/

# Side workspace: a meson build-check dir, an original-source copy, and
# small per-port JSON inventories. Not consumed by dpkg-buildpackage.
/vendor/

# Python caches
/tools/__pycache__/

# dpkg-buildpackage outputs under debian/
/debian/build/
/debian/tmp/
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/*.debhelper.log
/debian/*.substvars
/debian/*.debhelper

# Per-binary-package staging dirs created by debhelper. Trailing slashes
# matter: they prevent matching the corresponding *.install source files.
/debian/gir1.2-girepository-3.0/
/debian/gir1.2-girepository-3.0-dev/
/debian/gir1.2-glib-2.0/
/debian/gir1.2-glib-2.0-dev/
/debian/libgirepository-2.0-0/
/debian/libgirepository-2.0-dev/
/debian/libglib2.0-0t64/
/debian/libglib2.0-bin/
/debian/libglib2.0-data/
/debian/libglib2.0-dev/
/debian/libglib2.0-dev-bin/
/debian/libglib2.0-tests/
